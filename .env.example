# Bind address for the vision API.
VISION_API_HOST=0.0.0.0
VISION_API_PORT=8000

# Keep this deliberately small: for live guidance, a fresh frame is more useful
# than a deep backlog of stale frames.
VISION_FRAME_QUEUE_CAPACITY=4
VISION_RESULT_HISTORY=30
VISION_MAX_FRAME_BYTES=6000000
# Throttle the iOS relay before expensive vision inference.
GLASSES_FRAME_INTERVAL_SECONDS=1.0

# mock is runnable everywhere. Set openai_compatible to use an external VLM.
VISION_BACKEND=mock
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# `component_knowledge` is a two-pass VLM backend: describe the frame, retrieve
# the relevant kit records, then generate grounded guidance. Leave the path blank
# to use docs/components/components.json bundled with this repository.
COMPONENT_KNOWLEDGE_PATH=
COMPONENT_KNOWLEDGE_TOP_K=3

# Optional directory of replacement *.json workflow definitions.
WORKFLOW_DEFINITIONS_DIR=

# computer plays summaries with macOS `say`; glasses forwards `speak` events to
# a connected companion bridge; both does both. Leave off in normal operation.
SPEECH_MODE=off
